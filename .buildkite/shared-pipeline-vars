#!/bin/sh

# This file is `source`'d in CI before calling `buildkite-agent pipeline upload`, and can be used
# to set up some variables that will be interpolated in the `.yml` pipeline before uploading it.

# The ~> modifier is not currently used, but we check for it just in case
XCODE_VERSION=$(sed -E -n 's/^(~> )?(.*)/xcode-\2/p' .xcode-version)
CI_TOOLKIT_VERSION='8.1.0'
NVM_PLUGIN_VERSION='0.6.0'
DOCKER_PLUGIN_VERSION='v5.13.0'
NODE_VERSION=$(sed 's/^v//' .nvmrc)
RUBY_VERSION=$(sed 's/^ruby-//' .ruby-version)

export IMAGE_ID="$XCODE_VERSION"
export CI_TOOLKIT_PLUGIN="automattic/a8c-ci-toolkit#$CI_TOOLKIT_VERSION"
export NVM_PLUGIN="automattic/nvm#$NVM_PLUGIN_VERSION"
export DOCKER_PLUGIN="docker#$DOCKER_PLUGIN_VERSION"
export NODE_DOCKER_IMAGE="node:${NODE_VERSION}-bookworm"
export RUBY_DOCKER_IMAGE="ruby:${RUBY_VERSION}-bookworm"

# Resolve the push once for all four jobs. The last commit alone can omit earlier changes in the same push.
CI_TRUNK_PUSH_BASE=''
if [ "${BUILDKITE_SOURCE:-}" = webhook ] && [ "${BUILDKITE_GITHUB_EVENT:-}" = push ] &&
   [ "${BUILDKITE_PULL_REQUEST:-}" = false ] && [ "${BUILDKITE_BRANCH:-}" = trunk ] &&
   [ -z "${BUILDKITE_TAG:-}" ] && [ -z "${CI_CHANGED_FILES_BASE:-}" ] && [ "${STUDIO_CI_FULL_BUILD:-}" != 1 ]; then
  CI_TRUNK_PUSH_BASE=$(.buildkite/commands/trunk-push-base.sh) || CI_TRUNK_PUSH_BASE=''
fi
export CI_TRUNK_PUSH_BASE

# Decide skips on the upload agent so unrelated jobs never start or wait for their agents.
# One variable per job type (see `commands/should-skip-job.sh`): `false` runs the step, anything else is the reason to skip it.
# Each decision runs in its own shell so a script failure only leaves that job type's skip value empty (run).
SKIP_VALIDATION=$(.buildkite/commands/should-skip-job.sh validation || true)
SKIP_E2E=$(.buildkite/commands/should-skip-job.sh e2e || true)
SKIP_METRICS=$(.buildkite/commands/should-skip-job.sh metrics || true)
SKIP_FASTLANE=$(.buildkite/commands/should-skip-job.sh fastlane || true)
export SKIP_VALIDATION SKIP_E2E SKIP_METRICS SKIP_FASTLANE
echo "SKIP_VALIDATION=$SKIP_VALIDATION"
echo "SKIP_E2E=$SKIP_E2E"
echo "SKIP_METRICS=$SKIP_METRICS"
echo "SKIP_FASTLANE=$SKIP_FASTLANE"
