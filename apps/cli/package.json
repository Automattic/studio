{
	"name": "wp-studio",
	"author": "Automattic Inc.",
	"version": "1.17.0",
	"productName": "Studio CLI",
	"description": "WordPress Studio CLI",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"bin": {
		"studio": "dist/cli/main.mjs"
	},
	"files": [
		"assets/",
		"dist/cli/"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/studio.git",
		"directory": "apps/cli"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.91.1",
		"@earendil-works/pi-agent-core": "0.82.1",
		"@earendil-works/pi-ai": "0.82.1",
		"@earendil-works/pi-coding-agent": "0.82.1",
		"@earendil-works/pi-tui": "0.82.1",
		"@formatjs/intl-localematcher": "^0.5.4",
		"@inquirer/ansi": "^1.0.2",
		"@inquirer/core": "^10.3.2",
		"@inquirer/figures": "^1.0.15",
		"@inquirer/prompts": "^8.5.2",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@php-wasm/node": "3.1.45",
		"@php-wasm/universal": "3.1.45",
		"@php-wasm/util": "3.1.45",
		"@vscode/sudo-prompt": "^9.3.2",
		"@wordpress/i18n": "^6.20.0",
		"@wp-playground/blueprints": "3.1.45",
		"@wp-playground/cli": "3.1.45",
		"@wp-playground/storage": "3.1.45",
		"@wp-playground/wordpress": "3.1.45",
		"archiver": "^8.0.0",
		"atomically": "^2.1.1",
		"chalk": "^5.6.2",
		"chokidar": "^5.0.0",
		"cli-table3": "^0.6.5",
		"date-fns": "^4.1.0",
		"fs-extra": "^11.3.4",
		"glob": "^13.0.6",
		"http-proxy": "^1.18.1",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"picospinner": "^3.0.0",
		"playwright": "^1.52.0",
		"semver": "^7.7.4",
		"tar": "^7.5.21",
		"trash": "^10.0.1",
		"typebox": "^1.1.38",
		"yargs": "^18.0.0",
		"yargs-parser": "^22.0.0",
		"yauzl": "^3.3.0",
		"zod": "^4.3.6"
	},
	"scripts": {
		"build": "vite build --config ./vite.config.dev.ts",
		"build:prod": "vite build --config ./vite.config.prod.ts",
		"build:standalone": "vite build --config ./vite.config.standalone.ts",
		"build:npm": "vite build --config ./vite.config.npm.ts",
		"install:bundle": "npm install --omit=dev --no-audit --no-fund --no-package-lock --no-progress --install-links --no-workspaces && node ../../scripts/remove-fs-ext-other-platform-binaries.mjs",
		"package": "npm run install:bundle && npm run build:prod",
		"package:standalone": "npm run install:bundle && npm run build:standalone",
		"lint": "eslint .",
		"watch": "vite build --config ./vite.config.dev.ts --watch",
		"prepublishOnly": "npm run build:npm",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@studio/common": "file:../../packages/common",
		"@studio/local": "file:../local",
		"@types/archiver": "^8.0.0",
		"@types/http-proxy": "^1.17.17",
		"@types/node-forge": "^1.3.14",
		"@types/yargs": "^17.0.35",
		"@types/yauzl": "^2.10.3",
		"vite": "^8.0.16",
		"vite-plugin-static-copy": "^4.1.0"
	}
}
