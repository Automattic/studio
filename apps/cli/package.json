{
	"name": "wp-studio",
	"author": "Automattic Inc.",
	"version": "1.9.0",
	"productName": "Studio CLI",
	"description": "WordPress Studio CLI",
	"license": "GPL-2.0-or-later",
	"type": "module",
	"bin": {
		"studio": "dist/cli/main.mjs"
	},
	"files": [
		"assets/",
		"dist/cli/",
		"patches/",
		"scripts/"
	],
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/studio.git",
		"directory": "apps/cli"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.90.0",
		"@inquirer/prompts": "^8.3.2",
		"@mariozechner/pi-agent-core": "0.70.2",
		"@mariozechner/pi-ai": "0.70.2",
		"@mariozechner/pi-coding-agent": "0.70.2",
		"@mariozechner/pi-tui": "0.70.2",
		"@modelcontextprotocol/sdk": "^1.27.1",
		"@php-wasm/node": "3.1.28",
		"@php-wasm/universal": "3.1.28",
		"@php-wasm/util": "3.1.28",
		"@vscode/sudo-prompt": "^9.3.2",
		"@wordpress/i18n": "^6.18.0",
		"@wp-playground/blueprints": "3.1.28",
		"@wp-playground/cli": "3.1.28",
		"@wp-playground/common": "3.1.28",
		"@wp-playground/storage": "3.1.28",
		"@wp-playground/wordpress": "3.1.28",
		"archiver": "^7.0.1",
		"atomically": "^2.1.1",
		"cli-table3": "^0.6.5",
		"data-liberation": "github:Automattic/data-liberation-agent#17219c42b0420267302b138bf402930508006e0e",
		"fs-extra": "^11.3.4",
		"http-proxy": "^1.18.1",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"patch-package": "^8.0.1",
		"picospinner": "^3.0.0",
		"playwright": "^1.52.0",
		"semver": "^7.7.4",
		"tar": "^7.5.13",
		"trash": "^10.0.1",
		"tsx": "^4.19.0",
		"yargs": "^18.0.0",
		"yargs-parser": "^22.0.0",
		"yauzl": "^3.3.0",
		"zod": "^4.3.6"
	},
	"scripts": {
		"build": "vite build --config ./vite.config.dev.ts",
		"build:prod": "vite build --config ./vite.config.prod.ts",
		"build:npm": "vite build --config ./vite.config.npm.ts",
		"install:bundle": "npm install --omit=dev --no-package-lock --no-progress --install-links --no-workspaces && patch-package && node ../../scripts/remove-fs-ext-other-platform-binaries.mjs",
		"package": "npm run install:bundle && npm run build:prod",
		"lint": "eslint .",
		"watch": "vite build --config ./vite.config.dev.ts --watch",
		"prepublishOnly": "npm run build:npm",
		"postinstall": "node scripts/postinstall-npm.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@studio/common": "file:../../tools/common",
		"@studio/dla": "file:../../tools/dla",
		"@types/archiver": "^7.0.0",
		"@types/http-proxy": "^1.17.17",
		"@types/node-forge": "^1.3.14",
		"@types/yargs": "^17.0.35",
		"glob": "^13.0.6",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.1.5"
	}
}
