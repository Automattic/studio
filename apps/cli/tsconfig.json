{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"baseUrl": "../..",
		"paths": {
			"cli/*": [ "apps/cli/*" ],
			"@studio/common/*": [ "tools/common/*" ]
		}
	},
	"include": [ "**/*" ],
	"exclude": [
		"**/__mocks__/**/*",
		"**/node_modules/**/*",
		"**/dist/**/*",
		"**/out/**/*",
		"vitest.config.ts"
	]
}
