{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"paths": {
			"cli/*": [ "./*" ],
			"@studio/common/*": [ "../../packages/common/*" ],
			"@studio/design-md": [ "../../packages/design-md/index.ts" ],
			"@studio/local": [ "../local/src/index.ts" ]
		}
	},
	"include": [ "**/*" ],
	"exclude": [
		"**/__mocks__/**/*",
		"**/node_modules/**/*",
		"**/dist/**/*",
		"**/out/**/*",
		"./vitest.config.ts"
	]
}
