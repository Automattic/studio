{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "preserve",
		"moduleResolution": "bundler",
		"paths": {
			"cli/*": [ "./*" ],
			"@studio/common/*": [ "../../tools/common/*" ]
		}
	},
	"include": [ "**/*" ],
	"exclude": [
		"**/__mocks__/**/*",
		"**/node_modules/**/*",
		"**/dist/**/*",
		"**/out/**/*",
		"./vitest.config.ts"
	]
}
