{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"baseUrl": "../..",
		"paths": {
			"*": [ "node_modules/*" ],
			"cli/*": [ "apps/cli/*" ],
			"src/*": [ "apps/studio/src/*" ],
			"vendor/*": [ "vendor/*" ],
			"@studio/common/*": [ "tools/common/*" ],
		"@studio/addon-api": [ "tools/addon-api/index.ts" ],
		"@studio/addon-api/*": [ "tools/addon-api/*" ]
		}
	},
	"include": [ "**/*" ],
	"exclude": [ "**/__mocks__/**/*", "**/node_modules/**/*", "**/dist/**/*", "**/out/**/*" ],
	"references": [ { "path": "../../tools/common" } ]
}
