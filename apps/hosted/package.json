{
	"name": "@studio/hosted",
	"author": "Automattic Inc.",
	"version": "0.0.0",
	"productName": "Studio Web (hosted)",
	"description": "Experimental Studio Web backend (HTTP/SSE) for the browser UI",
	"license": "GPL-2.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Automattic/studio.git",
		"directory": "apps/hosted"
	},
	"dependencies": {
		"express": "^4.22.0",
		"express-rate-limit": "^8.5.2"
	},
	"scripts": {
		"build": "vite build --config ./vite.config.ts",
		"watch": "vite build --config ./vite.config.ts --watch",
		"start": "node dist/index.mjs",
		"dev": "npm run build && npm run start",
		"lint": "eslint .",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@studio/common": "file:../../packages/common",
		"@types/express": "^4.17.23",
		"vite": "^8.2.1"
	}
}
