# The image only needs the workspace manifests, the lockfile, the shared tsconfig, and the
# sources of the server and of the Studio CLI it runs.
*
!package.json
!package-lock.json
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!tools/*/package.json
!scripts
!packages
!apps/cli
!apps/local
!apps/liberate
**/node_modules
**/dist
wp-files
!wp-files/blueprints/blueprints.phar
apps/liberate/.data
