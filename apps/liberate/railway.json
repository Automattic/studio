{
	"$schema": "https://railway.com/railway.schema.json",
	"build": {
		"builder": "DOCKERFILE",
		"dockerfilePath": "apps/liberate/Dockerfile",
		"watchPatterns": [
			"apps/liberate/**",
			"apps/cli/**",
			"apps/local/**",
			"packages/**",
			"scripts/**",
			"package-lock.json"
		]
	},
	"deploy": {
		"healthcheckPath": "/healthz",
		"healthcheckTimeout": 120,
		"restartPolicyType": "ON_FAILURE",
		"restartPolicyMaxRetries": 5,
		"drainingSeconds": "30"
	}
}
