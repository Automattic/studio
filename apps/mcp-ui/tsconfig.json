{
	"compilerOptions": {
		"target": "ES2022",
		"module": "es2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": [ "vite/client" ],
		"paths": {
			"@/*": [ "./src/*" ]
		}
	},
	"include": [ "src/**/*" ],
	"exclude": [ "node_modules", "dist" ]
}
