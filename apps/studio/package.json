{
	"name": "studio-app",
	"author": "Automattic Inc.",
	"private": true,
	"productName": "Studio",
	"version": "1.17.0-beta1",
	"description": "Local WordPress development environment using Playgrounds",
	"homepage": "https://developer.wordpress.com/studio/",
	"license": "GPL-2.0-or-later",
	"main": "dist/main/index.js",
	"config": {
		"forge": "./forge.config.ts"
	},
	"scripts": {
		"start": "node ../../scripts/start-studio.mjs",
		"prestart": "npm -w wp-studio run build && node ../../scripts/ensure-dev-bundle-id.mjs",
		"make": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge make .",
		"make:windows-x64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge make . --arch=x64 --platform=win32",
		"make:windows-arm64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge make . --arch=arm64 --platform=win32",
		"make:macos-x64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && SKIP_DMG=true FILE_ARCHITECTURE=x64 electron-forge make . --arch=x64 --platform=darwin",
		"make:macos-arm64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && SKIP_DMG=true FILE_ARCHITECTURE=arm64 electron-forge make . --arch=arm64 --platform=darwin",
		"make:linux-x64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge make . --arch=x64 --platform=linux",
		"make:linux-arm64": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge make . --arch=arm64 --platform=linux",
		"install:bundle": "npm install --omit=dev --no-audit --no-fund --no-package-lock --no-progress --install-links --no-workspaces && node ../../scripts/apply-available-patches.mjs patches && node ../../scripts/remove-fs-ext-other-platform-binaries.mjs",
		"lint": "eslint src e2e",
		"package": "electron-vite build --config ./electron.vite.config.ts --outDir=dist && node --experimental-strip-types ../../scripts/build-ui-renderer.ts && electron-forge package .",
		"publish": "electron-forge publish .",
		"start-wayland": "npm -w wp-studio run build && electron-forge start . -- --enable-features=UseOzonePlatform --ozone-platform=wayland",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@formatjs/intl-localematcher": "^0.5.4",
		"@sentry/electron": "^7.15.0",
		"@studio/common": "file:../../packages/common",
		"@vscode/sudo-prompt": "^9.3.1",
		"@wordpress/i18n": "^6.20.0",
		"atomically": "^2.1.0",
		"compressible": "2.0.18",
		"compression": "^1.8.1",
		"electron-squirrel-startup": "^1.0.1",
		"electron2appx": "2.1.3",
		"fast-deep-equal": "^3.1.3",
		"file-stream-rotator": "^1.0.0",
		"follow-redirects": "^1.16.0",
		"fs-extra": "^11.3.2",
		"hpagent": "1.2.0",
		"http-proxy": "^1.18.1",
		"ignore": "^7.0.5",
		"lockfile": "^1.0.4",
		"semver": "^7.7.3",
		"shell-quote": "^1.10.0",
		"strip-ansi": "^7.1.2",
		"tar": "^7.5.21",
		"tus-js-client": "^4.3.1",
		"yauzl": "^3.2.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@automattic/color-studio": "^4.1.0",
		"@automattic/generate-password": "^0.2.0",
		"@automattic/interpolate-components": "^1.2.1",
		"@base-ui/react": "^1.3.0",
		"@earendil-works/pi-coding-agent": "0.81.0",
		"@electron-forge/cli": "^7.11.2",
		"@electron-forge/maker-deb": "^7.11.2",
		"@electron-forge/maker-dmg": "^7.11.2",
		"@electron-forge/maker-squirrel": "^7.11.2",
		"@electron-forge/maker-zip": "^7.11.2",
		"@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
		"@inquirer/prompts": "^8.5.2",
		"@reduxjs/toolkit": "^2.12.0",
		"@sentry/react": "^10.56.0",
		"@sentry/vite-plugin": "^5.3.0",
		"@tanstack/react-query": "^5.75.5",
		"@types/follow-redirects": "^1.14.4",
		"@types/fs-extra": "^11.0.4",
		"@types/http-proxy": "^1.17.17",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/semver": "^7.7.1",
		"@types/shell-quote": "^1.7.5",
		"@types/yauzl": "^2.10.3",
		"@vitejs/plugin-react": "^6.0.2",
		"@wordpress/components": "34.0.0",
		"@wordpress/compose": "8.0.0",
		"@wordpress/dataviews": "15.0.0",
		"@wordpress/element": "^7.0.0",
		"@wordpress/icons": "13.2.0",
		"@wordpress/private-apis": "^1.12.0",
		"@wordpress/react-i18n": "4.47.0",
		"@wordpress/theme": "0.14.0",
		"@wordpress/ui": "0.14.0",
		"@wp-playground/blueprints": "3.1.43",
		"cli-table3": "^0.6.5",
		"date-fns": "^4.1.0",
		"electron": "43.2.0",
		"electron-devtools-installer": "^4.0.0",
		"electron-vite": "6.0.0-beta.1",
		"patch-package": "^8.0.1",
		"postcss": "^8.5.23",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"react-redux": "^9.3.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"resize-observer-polyfill": "^1.5.1",
		"rimraf": "^6.1.3",
		"tailwindcss": "^3.3.6",
		"vite": "^8.0.16",
		"vite-plugin-static-copy": "^4.1.0",
		"vite-plugin-wasm": "^3.6.0",
		"wpcom": "^7.1.1",
		"yargs": "^18.0.0",
		"yargs-parser": "^22.0.0"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.50.2",
		"@rollup/rollup-win32-x64-msvc": "^4.50.2",
		"appdmg": "^0.6.6"
	},
	"overrides": {
		"fs-ext": {
			"nan": "2.25.0"
		}
	}
}
