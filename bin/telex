#!/bin/sh

# Telex stub - returns upgrade message for users not on a Telex-enabled plan

cat << 'EOF'
╭────────────────────────────────────────────────────────╮
│                                                        │
│  Telex is not available on your current plan          │
│                                                        │
│  Telex is a premium feature that provides a           │
│  sandboxed AI environment for building WordPress      │
│  blocks, plugins, and themes.                         │
│                                                        │
│  To access Telex, please upgrade your plan at:        │
│  https://wordpress.com/plans                          │
│                                                        │
╰────────────────────────────────────────────────────────╯
EOF

exit 1
