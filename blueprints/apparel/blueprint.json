{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Apparel",
		"description": "",
		"categories": [
			"Store",
			"Studio",
			"WooCommerce"
		],
		"author": "Automattic"
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
