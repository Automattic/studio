		{
			"step": "resetData"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Apparel",
				"blogdescription": "Everyday knitwear and accessories in easy color.",
				"permalink_structure": "/%postname%/",
				"woocommerce_currency": "USD",
				"woocommerce_allow_tracking": "no"
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "bundled",
				"path": "/content/site-content.wxr"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/woo-demo-store-setup.json",
