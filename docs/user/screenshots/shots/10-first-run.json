{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "first-run",
	"description": "First launch, signed out: the welcome dialog, Add site, creating a site, and the orientation guide",
	"scene": "moire",
	"look": "docs",
	"firstRun": true,
	"capture": {
		"target": {
			"role": "dialog",
			"has": {
				"role": "tablist",
				"name": "Ways to add a site"
			}
		}
	},
	"shots": [
		{
			"name": "welcome",
			"description": "First-run Welcome to WordPress Studio dialog",
			"meta": { "pages": [ "index.md" ], "replaces": [ "2024/04/welcome.png" ] },
			"steps": [
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					}
				}
			],
			"after": [
				{
					"click": {
						"role": "button",
						"name": "Not now"
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					},
					"hidden": true
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Welcome to WordPress Studio"
				}
			}
		},
		{
			"name": "add-site",
			"description": "Add site dialog: New / Connect / Import, Blueprint categories, and the Blueprints library",
			"meta": { "pages": [ "sites.md", "blueprints/index.md" ], "replaces": [ "2025/01/add-a-site.png" ] },
			"steps": [
				{
					"helper": "openAddSite"
				},
				{
					"waitFor": {
						"text": "Loading Blueprints…"
					},
					"hidden": true,
					"timeout": 30000,
					"optional": true
				},
				{
					"waitForImages": {
						"role": "dialog",
						"has": {
							"role": "tablist",
							"name": "Ways to add a site"
						}
					}
				}
			]
		},
		{
			"name": "blueprints-library",
			"description": "Add site → Blueprints → Business category",
			"meta": { "pages": [ "blueprints/index.md" ], "replaces": [ "2025/10/blueprints-library.png" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "Business",
						"exact": true
					}
				},
				{
					"waitFor": {
						"text": "Loading Blueprints…"
					},
					"hidden": true,
					"timeout": 30000,
					"optional": true
				},
				{
					"waitForImages": {
						"role": "dialog",
						"has": {
							"role": "tablist",
							"name": "Ways to add a site"
						}
					}
				}
			]
		},
		{
			"name": "blueprint-details",
			"description": "A Blueprint’s details, with Preview in browser and Use Blueprint",
			"meta": { "pages": [ "blueprints/index.md" ], "replaces": [ "2025/10/create-site-from-blueprint.png" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "dialog",
							"has": {
								"role": "tablist",
								"name": "Ways to add a site"
							}
						},
						"css": "[data-blueprint-slug]",
						"first": true
					}
				},
				{
					"waitFor": {
						"role": "button",
						"name": "Preview in browser"
					}
				},
				{
					"waitForImages": {
						"role": "dialog",
						"has": {
							"role": "button",
							"name": "Preview in browser"
						}
					}
				}
			],
			"after": [
				{
					"click": {
						"role": "button",
						"name": "Back to Blueprints"
					}
				},
				{
					"waitFor": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "Business",
						"exact": true
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"has": {
						"role": "button",
						"name": "Preview in browser"
					}
				}
			}
		},
		{
			"name": "add-site-connect",
			"description": "Add site → Connect, signed out: Connect to an existing WordPress",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "Connect",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "heading",
						"name": "Connect to an existing WordPress"
					}
				}
			]
		},
		{
			"name": "add-site-import",
			"description": "Add site → Import: Drop your file here / Choose file, for Blueprints, backups and WordPress exports",
			"meta": { "pages": [ "import-export.md", "blueprints/index.md" ], "replaces": [ "2025/01/add-a-site-1.png" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "Import",
						"exact": true
					}
				},
				{
					"waitFor": {
						"text": "Drop your file here"
					}
				}
			]
		},
		{
			"name": "create-site",
			"description": "Add site form for a blank site: Site name, Site folder, and Start from",
			"meta": { "pages": [ "sites.md" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "New",
						"exact": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Start with Blank site"
					}
				},
				{
					"fill": {
						"role": "textbox",
						"name": "Site name"
					},
					"value": "My WordPress Website",
					"blur": true
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"has": {
						"role": "textbox",
						"name": "Site name"
					}
				}
			}
		},
		{
			"name": "create-site-advanced",
			"description": "Add site form → Advanced (WordPress and PHP versions, File access, WordPress credentials, Domain name and HTTPS)",
			"meta": { "pages": [ "sites.md", "php-runtimes.md" ], "replaces": [ "2025/01/create-site-advanced.png" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Advanced",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "textbox",
						"name": "Domain name"
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"has": {
						"role": "textbox",
						"name": "Site name"
					}
				}
			}
		},
		{
			"name": "create-site-https",
			"description": "Add site form → Advanced with a custom Domain name and HTTPS turned on",
			"meta": { "pages": [ "ssl-in-studio.md" ], "replaces": [ "2025/03/create-site-https.png" ] },
			"steps": [
				{
					"fill": {
						"role": "textbox",
						"name": "Domain name"
					},
					"value": "my-wordpress-website.local",
					"blur": true
				},
				{
					"toggle": "Enable HTTPS",
					"on": true
				}
			],
			"after": [
				{
					"toggle": "Enable HTTPS",
					"on": false
				},
				{
					"fill": {
						"role": "textbox",
						"name": "Domain name"
					},
					"value": "",
					"blur": true
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"has": {
						"role": "textbox",
						"name": "Site name"
					}
				}
			}
		},
		{
			"name": "orientation-guide",
			"description": "Orientation guide, page 1, shown after the first site is created",
			"meta": { "pages": [ "index.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Add site",
						"exact": true,
						"within": {
							"role": "dialog",
							"has": {
								"role": "textbox",
								"name": "Site name"
							}
						}
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					},
					"timeout": 180000
				},
				{
					"waitFor": {
						"css": "button[aria-label=\"Stop My WordPress Website\"]",
						"first": true
					},
					"timeout": 120000
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Welcome to WordPress Studio"
				}
			}
		}
	]
}
