{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "workspace",
	"description": "The main window with the demo site: chat, command palette, preview tabs, the device toolbar, and the site’s start/stop button",
	"scene": "moire",
	"look": "docs",
	"shots": [
		{
			"name": "main-window-signed-out",
			"description": "Main window, signed out: sidebar, Studio Code chat, and the site preview",
			"meta": {
				"pages": [
					"index.md",
					"studio-code/index.md"
				],
				"replaces": [
					"2024/04/main-window-signed-out.png"
				]
			},
			"steps": [
				{
					"waitFor": {
						"text": "Loading site preview"
					},
					"hidden": true,
					"timeout": 60000,
					"optional": true
				}
			],
			"capture": {
				"settle": 2500
			},
			"annotate": [
				{
					"badge": {
						"role": "button",
						"name": "Add site",
						"first": true
					}
				},
				{
					"badge": {
						"role": "button",
						"name": "Site menu"
					}
				},
				{
					"badge": {
						"role": "textbox",
						"name": "Address"
					}
				},
				{
					"badge": {
						"role": "button",
						"name": "Publish…"
					}
				}
			]
		},
		{
			"name": "command-palette",
			"description": "Command palette (⌘K)",
			"meta": {
				"pages": [
					"index.md"
				]
			},
			"steps": [
				{
					"press": "ControlOrMeta+K"
				},
				{
					"waitFor": {
						"role": "combobox",
						"name": "Search commands"
					}
				}
			],
			"after": [
				{
					"press": "Escape"
				},
				{
					"waitFor": {
						"role": "combobox",
						"name": "Search commands"
					},
					"hidden": true
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Command palette"
				}
			}
		},
		{
			"name": "preview-destinations",
			"description": "Site preview → New tab: Browser, Admin, Design System, Database and Email log",
			"meta": {
				"pages": [
					"sites.md",
					"debugging/index.md",
					"frequently-asked-questions.md"
				],
				"replaces": [
					"2026/04/preview-destinations.png"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "New tab",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "menu",
						"name": "New tab"
					}
				}
			],
			"annotate": [
				{
					"outline": {
						"role": "menu",
						"name": "New tab"
					}
				}
			],
			"after": [
				{
					"press": "Escape"
				},
				{
					"waitFor": {
						"role": "menu",
						"name": "New tab"
					},
					"hidden": true
				}
			],
			"capture": {
				"target": [
					{
						"role": "menu",
						"name": "New tab"
					},
					{
						"role": "tablist",
						"name": "Preview tabs"
					},
					{
						"role": "textbox",
						"name": "Address"
					}
				],
				"pad": 32
			}
		},
		{
			"name": "design-system",
			"description": "Site preview → Design System: the demo site’s DESIGN.md as colors, type, components and guidelines",
			"meta": {
				"pages": [
					"studio-code/index.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "New tab",
						"exact": true
					}
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Design System"
					}
				},
				{
					"waitFor": {
						"role": "menu",
						"name": "New tab"
					},
					"hidden": true
				},
				{
					"wait": 2000
				}
			],
			"capture": {
				"settle": 2500
			},
			"after": [
				{
					"click": {
						"role": "tab",
						"name": "Design System",
						"exact": true
					},
					"button": "right"
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Close tab",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "tab",
						"name": "Design System",
						"exact": true
					},
					"hidden": true
				}
			]
		},
		{
			"name": "responsive-mode-presets",
			"description": "Device toolbar: the device menu open, with Responsive and the device sizes",
			"meta": {
				"pages": [
					"sites.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Expand panel",
						"exact": true
					}
				},
				{
					"wait": 800
				},
				{
					"click": {
						"role": "button",
						"name": "Browser options",
						"exact": true
					}
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Show device toolbar"
					}
				},
				{
					"waitFor": {
						"role": "toolbar",
						"name": "Responsive preview"
					}
				},
				{
					"click": {
						"within": {
							"role": "toolbar",
							"name": "Responsive preview"
						},
						"role": "button",
						"name": "Responsive",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "menuitemradio",
						"pattern": "^iPhone 17\\s*402"
					}
				}
			],
			"capture": {
				"target": [
					{
						"role": "menu"
					},
					{
						"role": "toolbar",
						"name": "Responsive preview"
					},
					{
						"role": "textbox",
						"name": "Address"
					},
					{
						"role": "button",
						"name": "Browser options",
						"exact": true
					}
				],
				"pad": 24
			}
		},
		{
			"name": "responsive-mode",
			"description": "The device toolbar at a phone size (iPhone 17), above the preview",
			"meta": {
				"pages": [
					"sites.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "menuitemradio",
						"pattern": "^iPhone 17\\s*402"
					}
				},
				{
					"wait": 1500
				}
			],
			"capture": {
				"settle": 2000
			},
			"after": [
				{
					"click": {
						"role": "button",
						"name": "Hide device toolbar"
					}
				},
				{
					"waitFor": {
						"role": "toolbar",
						"name": "Responsive preview"
					},
					"hidden": true
				},
				{
					"click": {
						"role": "button",
						"name": "Show chat",
						"exact": true
					}
				},
				{
					"wait": 800
				}
			]
		},
		{
			"name": "site-status-button",
			"description": "Sidebar site row with its Stop button and tooltip",
			"meta": {
				"pages": [
					"sites.md"
				],
				"replaces": [
					"2025/01/site-status-tooltip.png"
				]
			},
			"steps": [
				{
					"hover": {
						"role": "button",
						"name": "Stop {{site.name}}",
						"exact": true,
						"first": true
					}
				},
				{
					"wait": 1200
				}
			],
			"capture": {
				"keepMouse": true,
				"target": {
					"role": "button",
					"name": "Stop {{site.name}}",
					"exact": true,
					"first": true
				},
				"pad": [
					360,
					56
				]
			},
			"annotate": [
				{
					"arrow": {
						"role": "button",
						"name": "Stop {{site.name}}",
						"exact": true,
						"first": true
					},
					"from": "bottom-right"
				}
			]
		},
		{
			"name": "site-stopped",
			"description": "A stopped site: Start button in the sidebar and the saved preview image",
			"meta": {
				"pages": [
					"sites.md"
				],
				"replaces": [
					"2025/01/site-stopped.png"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Stop {{site.name}}",
						"exact": true,
						"first": true
					}
				},
				{
					"waitFor": {
						"role": "button",
						"name": "Start {{site.name}}",
						"exact": true,
						"first": true
					},
					"timeout": 60000
				}
			],
			"capture": {
				"settle": 1500
			}
		}
	]
}
