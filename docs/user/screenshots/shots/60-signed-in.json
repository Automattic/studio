{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in",
	"description": "Signed in to WordPress.com: the account menu, the Publish panel, the model menu, the account settings, and Send feedback",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"shots": [
		{
			"name": "main-window-signed-in",
			"description": "Main window, signed in: the account menu button at the bottom of the sidebar",
			"meta": { "pages": [ "index.md" ] },
			"steps": [
				{
					"waitFor": {
						"role": "button",
						"name": "{{account.name}}",
						"exact": true
					}
				},
				{
					"waitFor": {
						"text": "Loading site preview"
					},
					"hidden": true,
					"timeout": 60000,
					"optional": true
				}
			],
			"capture": {
				"settle": 2500
			}
		},
		{
			"name": "account-menu",
			"description": "Account menu: name, email, Providers, Usage, Support, Settings, Log out",
			"meta": { "pages": [ "index.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "{{account.name}}",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "menu",
						"name": "{{account.name}}"
					}
				}
			],
			"after": [
				{
					"press": "Escape"
				}
			]
		},
		{
			"name": "composer-add-menu",
			"description": "Chat box + menu, signed in: Add files, the commands, and Skills",
			"meta": { "pages": [ "studio-code/index.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Add",
						"exact": true
					}
				},
				{
					"waitFor": {
						"text": "Add files",
						"exact": true
					}
				}
			],
			"after": [
				{
					"press": "Escape"
				},
				{
					"waitFor": {
						"text": "Add files",
						"exact": true
					},
					"hidden": true
				}
			],
			"capture": {
				"target": [
					{
						"role": "dialog",
						"name": "Commands",
						"exact": true
					},
					{
						"role": "button",
						"name": "Add",
						"exact": true
					},
					{
						"role": "button",
						"name": "Send message"
					}
				],
				"pad": 32
			}
		},
		{
			"name": "annotate-toolbar",
			"description": "Annotate turned on above the site preview, before any note",
			"desktopOnly": true,
			"meta": { "pages": [ "studio-code/index.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Annotate",
						"exact": true
					}
				},
				{
					"wait": 1000
				}
			]
		},
		{
			"name": "annotate-note",
			"description": "Annotate: two saved notes on the page, and a third open on the hero photo, being typed",
			"desktopOnly": true,
			"meta": { "pages": [ "studio-code/index.md" ] },
			"steps": [
				{
					"helper": "clickInPreview",
					"args": [ "h1" ]
				},
				{
					"wait": 600
				},
				{
					"helper": "typeText",
					"args": [ "Make the wordmark a touch smaller" ]
				},
				{
					"press": "Enter"
				},
				{
					"wait": 600
				},
				{
					"helper": "clickInPreview",
					"args": [ ".wp-block-site-tagline" ]
				},
				{
					"wait": 600
				},
				{
					"helper": "typeText",
					"args": [ "Add Autumn edit after the tagline" ]
				},
				{
					"press": "Enter"
				},
				{
					"wait": 600
				},
				{
					"helper": "clickInPreview",
					"args": [ ".wp-block-cover img, .wp-block-image img, img" ]
				},
				{
					"wait": 600
				},
				{
					"helper": "typeText",
					"args": [ "Swap in the wool close-up" ]
				},
				{
					"wait": 500
				}
			],
			"capture": {
				"keepMouse": true
			},
			"after": [
				{
					"press": "Escape"
				},
				{
					"wait": 600
				}
			]
		},
		{
			"name": "annotate-staged",
			"description": "Annotate: two saved notes marked on the page and waiting in the chat box as \"2 annotations\"",
			"desktopOnly": true,
			"meta": { "pages": [ "studio-code/index.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Delete annotation",
						"exact": true
					}
				},
				{
					"wait": 600
				}
			],
			"capture": {
				"settle": 1200
			},
			"after": [
				{
					"helper": "discardAnnotations"
				}
			]
		},
		{
			"name": "publish-setup",
			"description": "Publish panel on a site with nothing published yet: Destination (WordPress.com), Who can view (Anyone with the link), Launch on WordPress.com and Create preview",
			"meta": { "pages": [ "sync.md", "preview-sites.md" ] },
			"steps": [
				{ "click": { "role": "button", "name": "Publish…", "exact": true } },
				{ "waitFor": { "role": "dialog", "name": "Publish", "exact": true } },
				{ "waitFor": { "role": "combobox", "name": "Destination" } }
			],
			"capture": { "target": { "role": "dialog", "name": "Publish", "exact": true } }
		},
		{
			"name": "publish-destination",
			"description": "Publish panel → Destination open: WordPress.com, Spacefast, and Connect to an existing site",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{ "click": { "role": "combobox", "name": "Destination" } },
				{ "waitFor": { "role": "option", "name": "Spacefast", "first": true } }
			],
			"capture": {
				"target": [ { "role": "dialog", "name": "Publish", "exact": true }, { "role": "listbox" } ]
			}
		},
		{
			"name": "publish-choose-site",
			"description": "Publish → Destination → Connect to an existing site: Choose an existing site, listing the account’s WordPress.com and Pressable sites",
			"meta": { "pages": [ "sync.md" ], "replaces": [ "2025/01/studio-connect-live-site.png" ] },
			"steps": [
				{ "click": { "role": "option", "pattern": "^Connect to an existing site" } },
				{ "waitFor": { "role": "dialog", "name": "Choose an existing site" } },
				{ "waitFor": { "role": "searchbox", "name": "Search sites" } },
				{ "wait": 1000 }
			],
			"capture": { "target": { "role": "dialog", "name": "Choose an existing site" } },
			"after": [
				{ "press": "Escape" },
				{ "press": "Escape" },
				{ "press": "Escape" },
				{
					"waitFor": { "role": "dialog", "pattern": "^(Publish|Choose|Preview details)" },
					"hidden": true
				}
			]
		},
		{
			"name": "model-menu",
			"description": "Chat box model menu: Fast, Balanced and Strong, with the AI credits remaining",
			"meta": {
				"pages": [
					"studio-code/index.md",
					"studio-code/choosing-an-ai-model-tier-in-studio-code.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Model"
					}
				},
				{
					"waitFor": {
						"role": "listbox",
						"name": "Choose a model"
					}
				}
			],
			"capture": {
				"target": [
					{
						"role": "dialog",
						"name": "Choose a model"
					},
					{
						"role": "combobox",
						"name": "Message WordPress Studio"
					},
					{
						"role": "button",
						"name": "Send message"
					}
				],
				"pad": 24
			}
		},
		{
			"name": "add-ai-credits",
			"description": "Add AI credits: the four one-time credit amounts",
			"meta": { "pages": [ "studio-code/ai-credits-guidelines.md" ] },
			"steps": [
				{
					"click": {
						"role": "option",
						"name": "Get more credits"
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Add AI credits"
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Add AI credits"
				}
			},
			"after": [
				{
					"click": {
						"role": "button",
						"name": "Cancel"
					}
				}
			]
		},
		{
			"name": "settings-usage",
			"description": "Settings → Usage: AI credits remaining, Add credits, and Preview sites",
			"meta": {
				"pages": [
					"preview-sites.md",
					"studio-code/index.md",
					"studio-code/ai-credits-guidelines.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "{{account.name}}",
						"exact": true
					}
				},
				{
					"click": {
						"role": "menuitem",
						"pattern": "^Settings"
					}
				},
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Settings scope"
						},
						"role": "tab",
						"name": "App"
					}
				},
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Settings sections"
						},
						"role": "tab",
						"name": "Usage",
						"exact": true
					}
				},
				{
					"waitFor": { "role": "group", "name": "Usage", "exact": true }
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Settings",
					"exact": true
				}
			}
		},
		{
			"name": "settings-sharing",
			"description": "Settings → Sharing, signed in",
			"meta": {
				"pages": [ "preview-sites.md" ],
				"replaces": [ "2025/01/studio-delete-all-preview-sites.png" ]
			},
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Settings sections"
						},
						"role": "tab",
						"name": "Sharing",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "group",
						"name": "Sharing previews on WordPress.com"
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Settings",
					"exact": true
				}
			}
		},
		{
			"name": "settings-ai-providers-signed-in",
			"description": "Settings → Providers, signed in: WordPress.com connected",
			"meta": { "pages": [ "studio-code/index.md" ] },
			"steps": [
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Settings sections"
						},
						"role": "tab",
						"name": "Providers",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "group",
						"name": "WordPress.com",
						"first": true
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Settings",
					"exact": true
				}
			}
		},
		{
			"name": "settings-provider-xai",
			"description": "Settings → Providers → xAI → Connect: Sign in with Grok and API key",
			"meta": { "pages": [ "providers.md" ] },
			"steps": [
				{ "scrollTo": { "css": "[data-setting-id=\"xai-provider\"]" } },
				{
					"click": {
						"within": { "css": "[data-setting-id=\"xai-provider\"]" },
						"role": "button",
						"name": "Connect"
					}
				},
				{ "waitFor": { "role": "menuitemradio", "name": "Sign in with Grok" } }
			],
			"capture": {
				"target": [ { "css": "[data-setting-id=\"xai-provider\"]" }, { "role": "menu" } ],
				"pad": 32
			},
			"after": [
				{
					"click": {
						"within": { "css": "[data-setting-id=\"xai-provider\"]" },
						"role": "button",
						"name": "Connect"
					}
				},
				{ "waitFor": { "role": "menu" }, "hidden": true }
			]
		},
		{
			"name": "settings-provider-local-llm",
			"description": "Settings → Providers → Local LLM → Connect: Server address, API key, Save and Cancel",
			"meta": { "pages": [ "providers.md" ] },
			"steps": [
				{
					"click": {
						"within": { "css": "[data-setting-id=\"local-llm-provider\"]" },
						"role": "button",
						"name": "Connect"
					}
				},
				{ "waitFor": { "role": "textbox", "name": "Server address" } },
				{ "scrollTo": { "role": "button", "name": "Save", "exact": true }, "offset": 400 }
			],
			"capture": {
				"target": [
					{ "css": "[data-setting-id=\"local-llm-provider\"]" },
					{ "role": "form", "name": "Local LLM connection" }
				],
				"pad": 32
			},
			"after": [ { "press": "Escape" } ]
		},
		{
			"name": "add-site-connect-signed-in",
			"description": "Add site → Connect, signed in, listing the account’s WordPress.com and Pressable sites",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Add site",
						"first": true
					}
				},
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "Connect"
					}
				},
				{
					"waitFor": {
						"role": "heading",
						"name": "Available to connect"
					}
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Add site"
				}
			},
			"after": [
				{
					"press": "Escape"
				}
			]
		},
		{
			"name": "send-feedback",
			"description": "Send feedback dialog, opened from the account menu → Support: Topic, Area, Message, Cancel and Send",
			"meta": { "pages": [ "feedback/index.md" ] },
			"steps": [
				{
					"helper": "closeMenus"
				},
				{
					"click": {
						"role": "button",
						"name": "{{account.name}}",
						"exact": true
					}
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Support",
						"exact": true
					}
				},
				{
					"click": {
						"role": "menuitem",
						"name": "Send feedback",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Send feedback"
					}
				},
				{
					"click": {
						"within": {
							"role": "group",
							"name": "Feedback areas"
						},
						"role": "button",
						"name": "Preview",
						"exact": true
					}
				},
				{
					"fill": {
						"role": "textbox",
						"name": "Message"
					},
					"value": "The device toolbar is great for checking a page on a phone. It would help to save my own sizes next to the built-in devices.",
					"blur": true
				}
			],
			"after": [
				{
					"click": {
						"within": {
							"role": "dialog",
							"name": "Send feedback"
						},
						"role": "button",
						"name": "Cancel"
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Send feedback"
					},
					"hidden": true
				}
			],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Send feedback"
				},
				"pad": 48
			}
		}
	]
}
