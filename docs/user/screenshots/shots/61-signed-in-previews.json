{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in-previews",
	"description": "Signed in, with made-up preview sites from preview-sites.json: the Publish panel's Choose a site list and a preview's Preview actions",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"previewSites": true,
	"shots": [
		{
			"name": "share-previews",
			"description": "Publish → Choose a site, with the site’s two previews, Publish somewhere else and Connect to an existing site. Settings → Sharing is opened first so the previews are loaded",
			"meta": {
				"pages": [
					"preview-sites.md"
				],
				"replaces": [
					"2025/01/studio-new-site-preview-link.png"
				]
			},
			"steps": [
				{
					"wait": 3000
				},
				{
					"click": {
						"role": "button",
						"name": "Settings",
						"exact": true,
						"first": true
					}
				},
				{
					"click": {
						"role": "tab",
						"pattern": "Sharing"
					}
				},
				{
					"waitFor": {
						"role": "group",
						"name": "Live previews"
					}
				},
				{
					"press": "Escape"
				},
				{
					"waitFor": {
						"role": "group",
						"name": "Live previews"
					},
					"hidden": true
				},
				{
					"click": {
						"role": "button",
						"name": "Publish…",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Choose a site"
					}
				}
			],
			"capture": {
				"target": [
					{
						"role": "dialog",
						"name": "Choose a site"
					},
					{
						"role": "button",
						"name": "Publish…",
						"exact": true
					}
				],
				"pad": 24
			}
		},
		{
			"name": "share-preview-actions",
			"description": "Publish → a preview’s Preview details, with its Preview actions menu open (Copy link, Delete preview…)",
			"meta": {
				"pages": [
					"preview-sites.md"
				],
				"replaces": [
					"2025/01/studio-preview-more-actions.png"
				]
			},
			"steps": [
				{
					"click": {
						"within": {
							"role": "dialog",
							"name": "Choose a site"
						},
						"role": "button",
						"name": "Autumn lookbook"
					}
				},
				{
					"waitFor": {
						"role": "heading",
						"name": "Preview details"
					}
				},
				{
					"click": {
						"within": {
							"role": "dialog",
							"name": "Preview details"
						},
						"role": "button",
						"name": "Preview actions",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "menuitem",
						"name": "Delete preview…"
					}
				}
			],
			"capture": {
				"target": [
					{
						"role": "dialog",
						"name": "Preview details"
					},
					{
						"role": "menu"
					},
					{
						"role": "button",
						"name": "Publish…",
						"exact": true
					}
				],
				"pad": 24
			}
		}
	]
}
