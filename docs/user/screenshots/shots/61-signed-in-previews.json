{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in-previews",
	"description": "Signed in, with made-up preview sites from preview-sites.json: the Publish panel's list of previews, a preview's details, and its actions",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"previewSites": true,
	"shots": [
		{
			"name": "publish-chooser",
			"description": "Publish panel on a site with two previews: Choose a site, listing the previews, then Publish somewhere else and Connect to an existing site",
			"meta": {
				"pages": [ "preview-sites.md" ],
				"replaces": [ "2025/01/studio-new-site-preview-link.png" ]
			},
			"steps": [
				{ "click": { "role": "button", "name": "Publish…", "exact": true } },
				{ "waitFor": { "role": "dialog", "name": "Choose a site" } },
				{ "wait": 800 }
			],
			"capture": { "target": { "role": "dialog", "name": "Choose a site" } }
		},
		{
			"name": "preview-details",
			"description": "Publish → a preview: Preview details, with its link, Who can view, Update and when it expires",
			"meta": { "pages": [ "preview-sites.md" ] },
			"steps": [
				{
					"click": {
						"within": { "role": "dialog", "name": "Choose a site" },
						"role": "button",
						"name": "Autumn lookbook"
					}
				},
				{ "waitFor": { "role": "dialog", "name": "Preview details" } },
				{ "waitFor": { "role": "button", "pattern": "^Update" } },
				{ "wait": 800 }
			],
			"capture": { "target": { "role": "dialog", "name": "Preview details" } }
		},
		{
			"name": "preview-actions",
			"description": "Preview details → Preview actions: Copy link and Delete preview…",
			"meta": {
				"pages": [ "preview-sites.md" ],
				"replaces": [ "2025/01/studio-preview-more-actions.png" ]
			},
			"steps": [
				{
					"click": {
						"within": { "role": "dialog", "name": "Preview details" },
						"role": "button",
						"name": "Preview actions"
					}
				},
				{ "waitFor": { "role": "menuitem", "pattern": "^Delete preview" } }
			],
			"capture": {
				"target": [ { "role": "dialog", "name": "Preview details" }, { "role": "menu" } ]
			},
			"after": [
				{ "press": "Escape" },
				{ "press": "Escape" },
				{ "press": "Escape" },
				{
					"waitFor": { "role": "dialog", "pattern": "^(Publish|Choose|Preview details)" },
					"hidden": true
				}
			]
		}
	]
}
