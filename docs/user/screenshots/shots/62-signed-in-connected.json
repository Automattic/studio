{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in-connected",
	"description": "Signed in, with the demo site connected to two made-up WordPress.com sites from wpcom-sites.json: the Publish panel's Choose a site list, and the pull and Choose files steps",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"connectedSites": true,
	"shots": [
		{
			"name": "publish-sites",
			"description": "Publish → Choose a site: the two connected websites, Publish somewhere else and Connect to an existing site",
			"meta": {
				"pages": [
					"sync.md"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Publish…",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Choose a site"
					}
				}
			],
			"capture": {
				"target": [
					{
						"role": "dialog",
						"name": "Choose a site"
					},
					{
						"role": "button",
						"name": "Publish…",
						"exact": true
					}
				],
				"pad": 24
			}
		},
		{
			"name": "pull-choose-files",
			"description": "A connected website’s Pull from live site… dialog, with the What to replace menu open",
			"meta": {
				"pages": [
					"sync.md"
				],
				"replaces": [
					"2025/01/studio-pull-selective.png"
				]
			},
			"steps": [
				{
					"click": {
						"within": {
							"role": "dialog",
							"name": "Choose a site"
						},
						"role": "button",
						"name": "Moire",
						"first": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Pull from live site…"
					}
				},
				{
					"click": {
						"role": "combobox",
						"name": "What to replace"
					}
				},
				{
					"waitFor": {
						"role": "listbox"
					}
				}
			],
			"after": [
				{
					"press": "Escape"
				},
				{
					"click": {
						"role": "button",
						"name": "Cancel",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "alertdialog"
					},
					"hidden": true
				}
			],
			"capture": {
				"target": [
					{
						"role": "alertdialog"
					},
					{
						"role": "listbox"
					}
				],
				"pad": 24
			}
		},
		{
			"name": "publish-choose-files",
			"description": "A connected website’s Update… → Publish changes? → What to publish → Choose specific files, with a few folders left out",
			"meta": {
				"pages": [
					"sync.md"
				],
				"replaces": [
					"2025/01/studio-selective-push.png"
				]
			},
			"steps": [
				{
					"click": {
						"role": "button",
						"name": "Update…"
					}
				},
				{
					"click": {
						"role": "button",
						"name": "What to publish"
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Choose specific files"
					}
				},
				{
					"waitFor": {
						"role": "checkbox",
						"name": "themes",
						"exact": true
					}
				},
				{
					"click": {
						"role": "checkbox",
						"name": "plugins",
						"exact": true
					}
				},
				{
					"click": {
						"role": "checkbox",
						"name": "uploads",
						"exact": true
					}
				}
			],
			"after": [],
			"capture": {
				"target": {
					"role": "dialog",
					"name": "Choose files"
				}
			}
		}
	]
}
