{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in-connected",
	"description": "Signed in, with the demo site connected to two made-up WordPress.com sites from wpcom-sites.json: the Publish panel's list of sites, a site's details, and the pull and publish dialogs with their file choices",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"connectedSites": true,
	"shots": [
		{
			"name": "publish-sites",
			"description": "Publish panel → Choose a site: the two connected websites, then Publish somewhere else and Connect to an existing site",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{ "click": { "role": "button", "name": "Publish…", "exact": true } },
				{ "waitFor": { "role": "dialog", "name": "Choose a site" } },
				{ "wait": 800 }
			],
			"capture": { "target": { "role": "dialog", "name": "Choose a site" } }
		},
		{
			"name": "publish-site-details",
			"description": "Publish → a connected WordPress.com site: its address and Site actions, Who can view, Pull from live site… and Update…",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{
					"click": {
						"within": { "role": "dialog", "name": "Choose a site" },
						"role": "button",
						"name": "Moire",
						"exact": true,
						"first": true
					}
				},
				{ "waitFor": { "role": "dialog", "name": "Publish", "exact": true } },
				{ "waitFor": { "role": "button", "pattern": "^Update" } },
				{ "wait": 800 }
			],
			"capture": { "target": { "role": "dialog", "name": "Publish", "exact": true } }
		},
		{
			"name": "pull-choose-files",
			"description": "Pull from live site… → What to replace: Choose files…, with a few items selected",
			"meta": { "pages": [ "sync.md" ], "replaces": [ "2025/01/studio-pull-selective.png" ] },
			"steps": [
				{ "click": { "role": "button", "name": "Pull from live site…" } },
				{ "waitFor": { "role": "alertdialog" } },
				{ "click": { "role": "combobox", "name": "What to replace" } },
				{ "click": { "role": "option", "name": "Choose files…" } },
				{ "waitFor": { "role": "checkbox", "name": "themes", "exact": true } },
				{ "click": { "role": "checkbox", "name": "Content and settings", "exact": true } },
				{ "click": { "role": "checkbox", "name": "themes", "exact": true } }
			],
			"capture": { "target": { "role": "alertdialog" } },
			"after": [
				{ "click": { "within": { "role": "alertdialog" }, "role": "button", "name": "Cancel" } },
				{ "waitFor": { "role": "alertdialog" }, "hidden": true }
			]
		},
		{
			"name": "publish-changes",
			"description": "Update… → Publish changes? with What to publish open: Everything, Database, Plugins, Themes, Uploads and Choose specific files",
			"meta": { "pages": [ "sync.md" ] },
			"steps": [
				{ "click": { "role": "button", "pattern": "^Update" } },
				{ "waitFor": { "role": "alertdialog" } },
				{ "click": { "role": "button", "name": "What to publish" } },
				{ "waitFor": { "role": "checkbox", "name": "Database" } }
			],
			"capture": {
				"target": [ { "role": "alertdialog" }, { "role": "dialog", "name": "What to publish" } ],
				"pad": 24
			}
		},
		{
			"name": "publish-choose-files",
			"description": "Publish changes? → Choose specific files: the Choose files dialog with a few items selected",
			"meta": { "pages": [ "sync.md" ], "replaces": [ "2025/01/studio-selective-push.png" ] },
			"steps": [
				{ "click": { "role": "button", "name": "Choose specific files" } },
				{ "waitFor": { "role": "dialog", "name": "Choose files" } },
				{ "waitFor": { "role": "checkbox", "name": "themes", "exact": true } },
				{ "click": { "role": "checkbox", "name": "themes", "exact": true } }
			],
			"capture": { "target": { "role": "dialog", "name": "Choose files" } }
		}
	]
}
