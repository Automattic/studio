{
	"$schema": "../../../../tools/capture-harness/schemas/script.schema.json",
	"name": "signed-in-chat",
	"description": "Signed in, with a recorded Studio Code chat on the demo site (chats/): the workspace mid-conversation",
	"scene": "moire",
	"look": "docs",
	"signedIn": true,
	"chats": [ "moire-home", "moire-lookbook", "moire-soft-armor", "moire-fabric-archive", "bistro-lune-reservations" ],
	"shots": [
		{
			"name": "workspace-chat",
			"description": "The main window with Moire pinned and a conversation updating its home page text",
			"meta": { "pages": [ "studio-code/index.md" ], "replaces": [ "2026/04/studio-code.png" ] },
			"steps": [
				{ "waitFor": { "role": "button", "name": "{{account.name}}", "exact": true } },
				{
					"waitFor": { "text": "Loading site preview" },
					"hidden": true,
					"timeout": 60000,
					"optional": true
				},
				{ "helper": "openSiteMenu" },
				{ "click": { "role": "menuitem", "name": "Pin" } },
				{ "waitFor": { "text": "Pinned", "exact": true } },
				{ "click": { "text": "Update the home page text", "first": true } },
				{ "waitFor": { "text": "Want me to add alt text", "first": true } },
				{ "wait": 1500 }
			],
			"capture": { "settle": 2500 }
		}
	]
}
