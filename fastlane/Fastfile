desc 'Notarize the compiled binary'
lane :notarize_binary do
  Dir[File.join(BUILDS_FOLDER, '**', 'Studio.app')].each do |path|
    notarize(
      package: path,
      api_key: app_store_connect_api_key,
      print_log: true
    )
  end

  Dir[File.join(BUILDS_FOLDER, '**', 'Studio-*.dmg')].each do |path|
    notarize(
      bundle_id: APPLE_BUNDLE_IDENTIFIER,
      package: path,
      api_key: app_store_connect_api_key,
      print_log: true
    )
  end
end

#
# Extract translatable strings from source code into the .pot file and optionally commit the changes
#
# @param commit_message [String, nil] The commit message to use if committing changes, or nil to skip commit.
# @param skip_confirm [Boolean] Whether to skip interactive confirmation before committing.
#
lane :generate_pot_file do |commit_message: nil, skip_confirm: false|
  pot_dir = File.join(PROJECT_ROOT_FOLDER, 'out', 'pots')

  sh('rm', '-rf', pot_dir)
  sh('mkdir', '-p', File.dirname(POT_FILE_PATH))
  sh(
    'npx', 'wp-babel-makepot',
    "#{PROJECT_ROOT_FOLDER}/{apps/studio/src,apps/cli,apps/ui/src,packages/common}/**/*.{js,jsx,ts,tsx}",
    '--ignore', "#{PROJECT_ROOT_FOLDER}/apps/cli/node_modules/**/*,**/*.d.ts",
    '--base', PROJECT_ROOT_FOLDER,
    '--dir', pot_dir,
    '--output', POT_FILE_PATH
  )

  if commit_message && (skip_confirm || UI.confirm('Commit updated strings?'))
    git_add(path: [POT_FILE_PATH])
    git_commit(
      path: [POT_FILE_PATH],
      message: commit_message,
      allow_nothing_to_commit: true
    )
  end
end

desc 'Ship the binary to internal testers'
lane :distribute_dev_build do
  distribute_builds
end

# Upload release builds to the Apps CDN and notify Slack.
#
# @param version [String] The release version (e.g., '1.7.4' or '1.7.4-beta1')
#
lane :distribute_release_build do |version: read_package_json_version|
  release_tag = "v#{version}"
  builds = distribute_builds(release_tag:)

  if DRY_RUN
    UI.message("[DRY RUN] Would notify Slack about #{release_tag}")
    UI.message("[DRY RUN] Release assets prepared for #{builds.each_value.map { |build| build[:name] }.join(', ')}")
    next
  end

  # Create the tag or draft GitHub release only after the build succeeds.
  # This avoids orphan tags or draft releases if the build fails.
  if StudioReleaseVersion.prerelease?(version)
    add_git_tag(tag: release_tag)
    push_git_tags(tag: release_tag)

    # Publish beta packages only after the release build succeeds and the beta tag is immutable.
    trigger_npm_publish(ref: release_tag, npm_tag: 'next')
  else
    create_draft_github_release(version: version, release_tag: release_tag, builds: builds)
  end

  slack(
    username: 'CI Bot',
    icon_url: 'https://octodex.github.com/images/jenktocat.jpg',
    message: ":tada: #{release_tag} is now available! :tada:",
    channel: '#studio',
    success: true,
    slack_url: get_required_env('SLACK_WEBHOOK'),
    payload: {
      # Link only the installers users download: "Full Install" builds plus the Linux .debs
      # (tagged "Update" but the sole Linux installer). Skip the Mac/Windows "Update" payloads,
      # and the unsigned Appx builds (grabbed from Buildkite for the Microsoft Store publish).
      ':studio-app-icon-mac: Release available for': builds.each_value
        .reject { |b| b[:install_type] == 'Update' && !b[:platform].to_s.start_with?('Linux') }
        .reject { |b| b[:platform].to_s.start_with?('Microsoft Store') }
        .map { |b| "[#{b[:name]}](#{b[:cdn_url]})" }.join(', ')
    },
    default_payloads: []
  )
end

# Prepare a standalone wp-studio npm release: bump version on a release branch and open a PR.
#
# Use this lane (followed by {publish_npm_package}) when you want to publish a new `wp-studio`
# version to npm independently of the regular Studio app release flow — for example, to ship a
# CLI-only patch. Both `studio-app` and `wp-studio` packages are bumped to keep them in lockstep
# (the app pins `wp-studio` exactly).
#
# This lane:
# - Creates a `npm-release/<version>` branch from `trunk`
# - Bumps `apps/studio/package.json` and `apps/cli/package.json` to <version>
# - Commits, pushes, and opens a PR against `trunk`
#
# After the PR is reviewed and merged, run {publish_npm_package} to tag the version-bump commit
# and trigger the GitHub Actions workflow that publishes to npm.
#
# @param version [String, nil] The release version (e.g., '1.7.4' or '1.7.4-beta1'). When omitted,
#   defaults to the next patch version after `trunk`'s current version (any `-betaN` suffix is
#   stripped before bumping). Beta versions must always be passed explicitly.
# @param skip_confirm [Boolean] Skip interactive confirmation prompts (default: false)
#
lane :prepare_npm_release do |version: nil, skip_confirm: false|
  fetch_main_branch
  main_branch_version = read_main_branch_package_json_version
  version ||= StudioReleaseVersion.next_patch_version!(main_branch_version)
  validate_npm_release_version!(version)

  branch_name = "npm-release/#{version}"
  release_tag = "v#{version}"

  if git_tag_exists(tag: release_tag, remote: true, remote_name: 'origin')
    UI.user_error!("Tag #{release_tag} already exists on the remote — pick a different version.")
  end

  UI.important <<~PROMPT
    Preparing wp-studio npm release #{version} (`#{MAIN_BRANCH}` is on #{main_branch_version}). This will:
    - Create branch `#{branch_name}` from `#{MAIN_BRANCH}`
    - Bump `studio-app` and `wp-studio` packages to #{version}
    - Commit, push, and open a PR against `#{MAIN_BRANCH}`

    After the PR is reviewed and merged, run:
      bundle exec fastlane publish_npm_package version:"#{version}"
  PROMPT
  next unless skip_confirm || UI.confirm('Continue?')

  Fastlane::Helper::GitHelper.checkout_and_pull(MAIN_BRANCH)
  Fastlane::Helper::GitHelper.create_branch(branch_name)

  bump_version_commit_and_push(version: version, set_upstream: true)

  pr_url = create_npm_release_pr(version: version, branch: branch_name)

  UI.success("Prepared npm release #{version}")
  UI.important <<~NEXT
    Next steps:
    1. Get the PR reviewed and merged: #{pr_url || branch_name}
    2. Run: bundle exec fastlane publish_npm_package version:"#{version}"
  NEXT
end

# Publish wp-studio to npm by tagging the version-bump commit and triggering the GitHub Actions
# workflow.
#
# Run this after the {prepare_npm_release} PR has merged into `trunk`. The lane:
# - Locates the commit on `trunk` where both `apps/studio/package.json` and
#   `apps/cli/package.json` declare the target version. The search walks history newest-to-oldest
#   so a later commit that bumped *past* the version (deleting its line) is correctly skipped in
#   favor of the introduction commit. A half-applied prep PR (only one workspace bumped) leaves
#   no candidate where both match, so the lane errors out before tagging. Tagging that specific
#   commit (rather than trunk's HEAD) means PRs that land on trunk between the prep merge and
#   the publish run are not silently included in the published artifact.
# - Tags the bump commit as `v<version>` and pushes the tag. Idempotent: if the tag already
#   exists at the expected commit, the lane logs and reuses it (this is the recovery path for a
#   workflow dispatch that succeeded at tagging but failed afterwards).
# - Dispatches `publish-npm-package.yml` to build and publish to npm with provenance via OIDC
#   trusted publishing. Versions ending in `-betaN` publish with the `next` dist-tag; everything
#   else publishes as `latest`.
#
# @param version [String, nil] The release version (e.g., '1.7.4' or '1.7.4-beta1'). When omitted,
#   defaults to `trunk`'s current `package.json` version — i.e. whatever the prepare_npm_release
#   PR set it to.
# @param skip_confirm [Boolean] Skip interactive confirmation prompts (default: false)
#
lane :publish_npm_package do |version: nil, skip_confirm: false|
  fetch_main_branch
  version ||= read_main_branch_package_json_version
  validate_npm_release_version!(version)

  release_tag = "v#{version}"
  npm_tag = StudioReleaseVersion.npm_dist_tag_for!(version)
  tag_label = npm_tag || 'latest'

  bump_commit = StudioReleaseGit.find_npm_release_bump_commit!(
    branch: "origin/#{MAIN_BRANCH}", version: version
  )
  UI.user_error!(
    "Could not find a commit on `#{MAIN_BRANCH}` where both `apps/studio/package.json` and " \
    "`apps/cli/package.json` declare version #{version}. Did the prepare_npm_release PR " \
    'merge into trunk with both workspaces bumped?'
  ) if bump_commit.nil?

  short_sha = bump_commit[0..8]

  UI.important <<~PROMPT
    Publishing wp-studio #{version} to npm. This will:
    - Tag the version-bump commit #{short_sha} on `#{MAIN_BRANCH}` as `#{release_tag}`
      (reused if it already exists at that commit, e.g. recovery from a failed dispatch)
    - Push the tag to `origin`
    - Dispatch the `publish-npm-package.yml` GitHub Actions workflow
    - Publish `wp-studio` to npm with the `#{tag_label}` dist-tag

    Reminder: after publishing, update the public changelog at
      https://developer.wordpress.com/docs/developer-tools/studio/changelog/
  PROMPT
  next unless skip_confirm || UI.confirm('Continue?')

  ensure_release_tag(release_tag: release_tag, commit: bump_commit)

  trigger_npm_publish(ref: release_tag, npm_tag: npm_tag)
end

