{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mjs,cjs}"],
			"project": "scripts/**/*.{ts,mjs,cjs}"
		},
		"apps/studio": {
			"entry": [
				"src/index.ts",
				"src/preload.ts",
				"forge.config.ts",
				"native/build.ts",
				"e2e/global-setup.ts",
				"e2e/**/*.test.ts"
			],
			"project": "{src,e2e}/**/*.{ts,tsx}",
			"ignoreDependencies": ["ignore", "tus-js-client", "wpcom", "@wp-playground/blueprints"]
		},
		"apps/cli": {
			"entry": [
				"index.ts",
				"php-server-child.ts",
				"frontend-server-child.ts",
				"process-manager-daemon.ts",
				"proxy-daemon.ts",
				"logger.ts",
				"ai/eval-runner-entry.ts",
				"commands/**/*.ts",
				"vite.config.*.ts"
			],
			"project": "**/*.ts",
			// Only bundled packages import these: pi, to resize images in its Read tool, and
			// @studio/providers, to turn generated images into WebP. They stay installed because
			// they read their .wasm files from their own folders.
			"ignoreDependencies": ["@silvia-odwyer/photon-node", "@jsquash/jpeg", "@jsquash/png", "@jsquash/webp"]
		},
		"apps/ui": {
			"entry": [
				"src/main.local.tsx",
				"src/main.cloud.tsx",
				"src/dev/{chat,animation,annotate-tip,update-preview,email-preview,sidebar-preview}.tsx"
			],
			"project": "src/**/*.{ts,tsx}"
		},
		"apps/local": {
			"entry": ["src/index.ts"],
			"project": "src/**/*.{ts,tsx}"
		},
		"packages/agent": {
			"project": "**/*.ts"
		},
		"packages/blueprints": {
			"project": "**/*.ts"
		},
		"packages/ds": {
			"project": "**/*.{ts,tsx}"
		},
		"packages/common": {
			"entry": ["globals.ts"],
			"project": "**/*.ts"
		},
		"tools/capture-harness": {
			"entry": ["src/tests/*.test.ts"],
			"project": "**/*.ts"
		},
		"tools/eslint-plugin-studio": {
			"project": "**/*.{js,ts}"
		}
	},
	"ignoreDependencies": [
		"@automattic/wp-babel-makepot"
	],
	"ignoreBinaries": ["attrib", "apt-get", "Xvfb", "ditto", "dpkg-deb", "pgrep"]
}
