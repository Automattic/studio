{
	"$schema": "https://unpkg.com/knip@5/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.{ts,mjs,cjs}", "tools/marketing-screenshots/**/*.ts"],
			"project": ["scripts/**/*.{ts,mjs,cjs}", "tools/marketing-screenshots/**/*.ts"]
		},
		"apps/studio": {
			"entry": [
				"src/index.ts",
				"src/preload.ts",
				"src/migrations/index.ts",
				"src/additional-phrases.ts",
				"forge.config.ts",
				"electron.vite.config.ts",
				"e2e/global-setup.ts",
				"e2e/**/*.test.ts"
			],
			"project": "{src,e2e}/**/*.{ts,tsx}"
		},
		"apps/cli": {
			"entry": [
				"index.ts",
				"php-server-child.ts",
				"playground-server-child.ts",
				"process-manager-daemon.ts",
				"proxy-daemon.ts",
				"reprint-child.ts",
				"logger.ts",
				"ai/eval-runner.ts",
				"commands/**/*.ts",
				"vite.config.*.ts"
			],
			"project": "**/*.ts"
		},
		"apps/ui": {
			"entry": ["src/main.hosted.tsx", "src/main.local.tsx", "src/main.marketing.tsx"],
			"project": "src/**/*.{ts,tsx}"
		},
		"apps/hosted": {
			"entry": ["src/index.ts"],
			"project": "src/**/*.{ts,tsx}"
		},
		"apps/local": {
			"entry": ["src/index.ts"],
			"project": "src/**/*.{ts,tsx}"
		},
		"packages/common": {
			"entry": ["translations/index.ts", "globals.ts"],
			"project": "**/*.ts"
		},
		"packages/data-liberation-agent": {
			"project": "src/**/*.{ts,tsx}"
		},
		"tools/eslint-plugin-studio": {
			"project": "**/*.{js,ts}"
		}
	},
	"ignoreDependencies": [
		"@sentry/react",
		"@wp-playground/cli",
		"@automattic/wp-babel-makepot"
	],
	"ignoreBinaries": ["scripts/eval/promptfoo.config.yaml"]
}
