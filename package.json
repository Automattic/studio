		"react-redux": "^9.2.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"semver": "^7.7.3",
		"shell-quote": "^1.8.3",
		"strip-ansi": "^7.1.2",
		"tar": "^7.5.2",
		"ts-node": "^10.9.2",
		"tus-js-client": "^4.3.1",
		"winreg": "1.2.4",
		"wpcom": "^7.1.1",
		"wpcom-xhr-request": "^1.3.0",
		"yargs": "^18.0.0",
		"yargs-parser": "^22.0.0",
		"yauzl": "^3.2.0",
		"zod": "^4.0.0"
	},
	"optionalDependencies": {
