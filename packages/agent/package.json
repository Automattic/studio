{
	"name": "@studio/agent",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "The Studio Code agent: its contract with the apps (protocol) and the agent itself (node)",
	"exports": {
		"./protocol/*": "./protocol/*.ts",
		"./node": "./node/index.ts",
		"./node/annotation-tracks": "./node/annotation-tracks.ts",
		"./node/global-instructions": "./node/global-instructions.ts",
		"./node/local-media": "./node/local-media.ts",
		"./node/run-manager": "./node/run-manager.ts",
		"./node/sessions/manage": "./node/sessions/manage.ts",
		"./node/sessions/placement": "./node/sessions/placement.ts",
		"./node/sessions/root-migration": "./node/sessions/root-migration.ts",
		"./node/sessions/store": "./node/sessions/store.ts"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@studio/common": "file:../common",
		"@studio/ds": "file:../ds",
		"@studio/providers": "file:../providers",
		"@studio/design-md": "file:../design-md",
		"@wordpress/i18n": "^6.30.0",
		"diff": "8.0.4",
		"playwright": "^1.64.1",
		"typebox": "^1.1.38",
		"yaml": "^2.9.0",
		"zod": "^4.3.6"
	}
