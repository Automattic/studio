{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@studio/agent/*": [ "./*" ],
			"@wp-playground/blueprints/blueprint-schema-validator": [ "../../node_modules/@wp-playground/blueprints/blueprint-schema-validator" ]
		}
	},
	"include": [ "**/*", "**/*.json" ],
	"exclude": [ "**/node_modules/**/*", "**/dist/**/*", "vitest.config.ts" ]
}
