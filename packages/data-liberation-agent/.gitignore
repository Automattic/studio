# dist/ is build output, EXCEPT the committed plugin bundles: the Claude/Codex
# plugin installer copies this package verbatim (no npm install, no build), so
# the self-contained MCP server bundle and the skill-invoked driver bundles
# must live in git.
dist/*
!dist/mcp-server.bundle.mjs
!dist/capture-engine.bundle.mjs
!dist/scripts/
