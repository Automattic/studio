{
	"compilerOptions": {
		"target": "ES2020",
		"module": "es2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": [ "vite/client", "vitest/globals", "@testing-library/jest-dom/vitest" ]
	},
	"include": [ "**/*" ],
	"exclude": [ "**/node_modules/**/*", "vitest.config.ts" ]
}
