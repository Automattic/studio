{
  "mcpServers": {
    "wordpress-studio": {
      "command": "./scripts/launch-mcp",
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "SHELL",
        "STUDIO_CLI_BIN",
        "STUDIO_NODE",
        "STUDIO_CLI_URL",
        "STUDIO_CLI_HOME",
        "STUDIO_INSTALLER_URL"
      ],
      "startup_timeout_sec": 600,
      "tool_timeout_sec": 3600,
      "env": {
        "STUDIO_PLUGIN_ID": "studio-code@studio"
      }
    }
  }
}
