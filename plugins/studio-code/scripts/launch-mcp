#!/bin/sh
# Starts the Studio MCP server (`studio mcp`). Desktop agents often start plugin
# servers without the user's shell PATH, so this looks past it: a development
# build via STUDIO_CLI_BIN (a CLI main.mjs, run with STUDIO_NODE or the first
# Node.js found), the `studio` command, then the known install locations. With
# no Studio CLI at all, it starts a small setup server that installs one in the
# background and then hands over to it (or, without Node.js, installs it first).
#
# stdout carries the MCP messages: anything else must go to stderr.

INSTALLER_URL="${STUDIO_INSTALLER_URL:-https://wordpress.studio/install.sh}"

find_node() {
	if [ -n "$STUDIO_NODE" ]; then
		echo "$STUDIO_NODE"
	elif command -v node >/dev/null 2>&1; then
		command -v node
	elif [ -x /Applications/Studio.app/Contents/Resources/bin/node ]; then
		echo /Applications/Studio.app/Contents/Resources/bin/node
	elif [ -x /Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node ]; then
		echo /Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node
	else
		"${SHELL:-/bin/sh}" -lic 'command -v node' 2>/dev/null | tail -n 1
	fi
}

start_installed() {
	for candidate in \
		"$HOME/.studio/bin/studio" \
		"$HOME/.local/bin/studio" \
		/Applications/Studio.app/Contents/Resources/bin/studio-cli.sh \
		/usr/lib/studio/resources/bin/studio-cli.sh; do
		if [ -x "$candidate" ]; then
			exec "$candidate" mcp
		fi
	done
}

if [ -n "$STUDIO_CLI_BIN" ]; then
	exec "$(find_node)" "$STUDIO_CLI_BIN" mcp
fi

if command -v studio >/dev/null 2>&1; then
	exec studio mcp
fi

start_installed

NODE="$(find_node)"
if [ -n "$NODE" ] && [ -x "$NODE" ]; then
	exec "$NODE" "$(dirname "$0")/bootstrap-mcp.mjs"
fi

echo 'WordPress Studio CLI not found: installing it into ~/.studio (a download of about 260 MB)...' >&2
if curl -fsSL "$INSTALLER_URL" | sh >&2; then
	start_installed
fi

echo 'Could not install the WordPress Studio CLI. Install it with `curl -fsSL https://wordpress.studio/install.sh | bash` and start a new session.' >&2
exit 1
