{
  "name": "wp-studio",
  "displayName": "WordPress Studio",
  "version": "0.1.1",
  "description": "Build, design, and manage WordPress sites with WordPress Studio: create local sites with Studio's design workflow, preview them, and publish to WordPress.com.",
  "author": {
    "name": "Automattic Inc.",
    "url": "https://automattic.com"
  },
  "homepage": "https://developer.wordpress.com/studio/",
  "repository": "https://github.com/Automattic/studio",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "wordpress",
    "wordpress-studio",
    "wordpress-com",
    "site-builder",
    "block-theme"
  ],
  "icon": "./assets/logo.png",
  "documentationUrl": "https://developer.wordpress.com/docs/developer-tools/studio/",
  "supportUrl": "https://developer.wordpress.com/contact/",
  "privacyPolicyUrl": "https://automattic.com/privacy/",
  "termsOfServiceUrl": "https://wordpress.com/tos/",
  "mcpServers": {
    "wordpress-studio": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap-mcp.mjs"
      ],
      "env": {
        "STUDIO_PLUGIN_ID": "wp-studio@studio"
      }
    }
  }
}
