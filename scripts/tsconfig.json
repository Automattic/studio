{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "preserve",
		"moduleResolution": "bundler",
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"paths": {
			"@studio/common/*": [ "../packages/common/*" ]
		}
	},
	"include": [ "**/*" ],
	"exclude": [ "**/node_modules/**/*" ]
}
