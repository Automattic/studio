{
	"$schema": "../schemas/script.schema.json",
	"scene": "moire",
	"name": "moire-design-looks",
	"description": "A new blank site asks for a slow-fashion journal called Moire; the agent offers four looks (design-looks/), Moire's own among them",
	"firstRun": true,
	"signedIn": true,
	"shots": [
		{
			"name": "design-looks",
			"description": "A new blank site's first chat asking for a slow-fashion journal called Moire, and Studio Code's pick of four looks (design-looks/), Moire's own among them",
			"steps": [
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Not now"
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					},
					"hidden": true
				},
				{
					"helper": "openAddSite"
				},
				{
					"click": {
						"within": {
							"role": "tablist",
							"name": "Ways to add a site"
						},
						"role": "tab",
						"name": "New",
						"exact": true
					}
				},
				{
					"click": {
						"role": "button",
						"name": "Start with Blank site"
					}
				},
				{
					"fill": {
						"role": "textbox",
						"name": "Site name"
					},
					"value": "My WordPress Website",
					"blur": true
				},
				{
					"click": {
						"within": {
							"role": "dialog",
							"has": {
								"role": "textbox",
								"name": "Site name"
							}
						},
						"role": "button",
						"name": "Add site",
						"exact": true
					}
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					},
					"timeout": 180000
				},
				{
					"press": "Escape"
				},
				{
					"waitFor": {
						"role": "dialog",
						"name": "Welcome to WordPress Studio"
					},
					"hidden": true
				},
				{
					"waitFor": {
						"css": "button[aria-label=\"Stop My WordPress Website\"]",
						"first": true
					},
					"timeout": 120000
				},
				{
					"waitFor": {
						"text": "Loading site preview"
					},
					"hidden": true,
					"timeout": 60000,
					"optional": true
				},
				{
					"helper": "stubAgentRuns"
				},
				{
					"helper": "dragSeparator",
					"args": [
						"Resize panel",
						260
					]
				},
				{
					"click": {
						"role": "combobox",
						"name": "Message WordPress Studio"
					}
				},
				{
					"helper": "typeText",
					"args": [
						"Build a site for my slow-fashion journal called Moire"
					]
				},
				{
					"click": {
						"role": "button",
						"name": "Send message"
					}
				},
				{
					"wait": 1500
				},
				{
					"helper": "playAgentTurn",
					"args": [
						"design-looks"
					]
				},
				{
					"waitFor": {
						"text": "Which look should I build?",
						"exact": true
					}
				},
				{
					"wait": 2000
				}
			],
			"capture": {
				"settle": 2500
			}
		}
	]
}
