{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": [ "ES2023", "DOM", "DOM.Iterable" ],
		"module": "preserve",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true
	},
	"include": [ "**/*.ts" ],
	"exclude": [ "**/node_modules/**/*" ]
}
