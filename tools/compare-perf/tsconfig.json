{
	"compilerOptions": {
		"target": "ES2022",
		"lib": [ "ES2022" ],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": true,
		"resolveJsonModule": true,
		"types": [ "node" ]
	},
	"include": [ "*.ts", "../metrics/metric-config.ts" ],
	"exclude": [ "node_modules" ]
}
