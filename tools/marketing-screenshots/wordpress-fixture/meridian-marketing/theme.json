{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "forest", "color": "#173f35", "name": "Forest" },
				{ "slug": "cream", "color": "#fffaf0", "name": "Cream" },
				{ "slug": "coffee", "color": "#cf9363", "name": "Coffee" },
				{ "slug": "sand", "color": "#e9dfcc", "name": "Sand" },
				{ "slug": "gold", "color": "#e6be75", "name": "Gold" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1440px"
		},
		"spacing": {
			"units": [ "px", "rem", "vw", "vh", "%" ]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"name": "Sans",
					"slug": "sans"
				},
				{
					"fontFamily": "Georgia, 'Times New Roman', serif",
					"name": "Serif",
					"slug": "serif"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--cream)",
			"text": "var(--wp--preset--color--forest)"
		},
		"spacing": {
			"blockGap": "0"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)"
		},
		"elements": {
			"button": {
				"border": { "radius": "999px" },
				"color": {
					"background": "var(--wp--preset--color--forest)",
					"text": "var(--wp--preset--color--cream)"
				},
				"typography": {
					"fontSize": "0.75rem",
					"fontWeight": "700",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)"
				}
			}
		}
	}
}
