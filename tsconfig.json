{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "dist",
		"paths": {
			"*": [ "node_modules/*" ],
			"cli/*": [ "apps/cli/*" ],
			"src/*": [ "apps/studio/src/*" ],
			"vendor/*": [ "vendor/*" ],
			"@studio/common/*": [ "tools/common/*" ]
		}
	},
	"include": [
		"apps/studio/src/**/*",
		"apps/studio/e2e/**/*",
		"apps/cli/**/*",
		"tools/common/**/*",
		"scripts/**/*",
		"./vitest.global-setup.ts"
	],
	"exclude": [ "**/__mocks__/**/*", "**/node_modules/**/*", "**/dist/**/*", "**/out/**/*" ]
}
