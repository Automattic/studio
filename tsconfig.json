{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"module": "es2022",
		"moduleResolution": "bundler",
		"outDir": "dist",
		"paths": {
			"cli/*": [ "./apps/cli/*" ],
			"src/*": [ "./apps/studio/src/*" ],
			"vendor/*": [ "./vendor/*" ],
			"@studio/common/*": [ "./packages/common/*" ],
			"@studio/agent/*": [ "./packages/agent/*" ],
			"@studio/design-md": [ "./packages/design-md/index.ts" ],
			"@studio/providers": [ "./packages/providers/index.ts" ],
			"@studio/providers/*": [ "./packages/providers/*" ],
			"@studio/blueprints": [ "./packages/blueprints/index.ts" ],
			"@studio/blueprints/node": [ "./packages/blueprints/node.ts" ],
			"@studio/database": [ "./packages/database/index.ts" ],
			"@studio/database/node": [ "./packages/database/node.ts" ]
		}
	},
	"include": [
		"./apps/studio/src/**/*",
		"./apps/studio/e2e/**/*",
		"./apps/cli/**/*",
		"./packages/common/**/*",
		"./packages/agent/**/*",
		"./packages/design-md/**/*",
		"./packages/providers/**/*",
		"./packages/blueprints/**/*",
		"./packages/database/**/*",
		"./vitest.global-setup.ts",
		"./scripts/**/*"
	],
	"exclude": [ "**/__mocks__/**/*", "**/node_modules/**/*", "**/dist/**/*", "**/out/**/*" ]
}
